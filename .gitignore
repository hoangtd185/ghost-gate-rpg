# Dependencies and build output
node_modules/
client/dist/

# Player data and secret keys (data/game.db, data/secret.key) - never commit.
# The leading slash matters: only the top-level data/ folder, not client/src/data/.
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.key
*.pem
*.p12

# Environment variables with secrets (keep the example file)
.env
.env.*
!.env.example

# Misc
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
tests/e2e/out/
.claude/
