{
  "name": "quy-mon-quan",
  "version": "1.0.0",
  "description": "2D side-scrolling wuxia ghost RPG (online presence and chat, bots fill empty maps)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch server/src/index.js --dev",
    "build": "node tools/build.mjs",
    "start": "node server/src/index.js",
    "test": "node --test --test-reporter=spec \"tests/unit/*.test.mjs\"",
    "uat": "node tools/build.mjs && node --test --test-reporter=spec --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "uat:browser": "playwright-core install chromium",
    "check": "node tools/check-secrets.mjs",
    "hooks": "node tools/check-secrets.mjs --install-hook"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
