# Example config. Copy it to .env and edit:  cp .env.example .env   (Windows: copy .env.example .env)
# .env holds secrets, so it must NOT go to GitHub (it is already in .gitignore). Only commit this .env.example.

# development | production. In production the server refuses to start without TOKEN_SECRET.
NODE_ENV=development

# Port and address to listen on
PORT=3000
HOST=0.0.0.0

# Folder for the SQLite database (game.db). On Railway/Docker point it at a volume, e.g. /data
DATA_DIR=./data

# Login token signing key, at least 32 characters. Changing it logs everyone out.
# Generate a random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Login tokens expire after this many days
TOKEN_DAYS=30

# Allow new accounts (set to false if only you should play)
ALLOW_REGISTER=true

# Maximum characters per account
MAX_CHARS_PER_USER=6

# Brute-force / spam protection: max logins and API requests per minute per IP
LOGIN_LIMIT_PER_MIN=10
API_LIMIT_PER_MIN=240

# Enable when behind a proxy (Railway, Render, Nginx) so limits apply to the real player IP
TRUST_PROXY=false

# Leave empty when the game page and the API share one address (the usual case). Only set it when the client is hosted elsewhere, e.g. https://game.example.com
CORS_ORIGIN=
