# Mẫu cấu hình. Copy thành file .env rồi sửa:  cp .env.example .env   (Windows: copy .env.example .env)
# File .env chứa bí mật nên KHÔNG đưa lên GitHub (đã có trong .gitignore). Chỉ commit file .env.example này.

# development | production. Khi là production, server bắt buộc phải có TOKEN_SECRET.
NODE_ENV=development

# Cổng và địa chỉ lắng nghe
PORT=3000
HOST=0.0.0.0

# Thư mục chứa database SQLite (game.db). Trên Railway/Docker trỏ vào volume, vd /data
DATA_DIR=./data

# Khoá ký token đăng nhập, dài ít nhất 32 ký tự. Đổi khoá = mọi người phải đăng nhập lại.
# Tạo khoá ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Token đăng nhập hết hạn sau bao nhiêu ngày
TOKEN_DAYS=30

# Cho phép tạo tài khoản mới (đặt false khi chỉ muốn mình bạn chơi)
ALLOW_REGISTER=true

# Số nhân vật tối đa mỗi tài khoản
MAX_CHARS_PER_USER=6

# Chống dò mật khẩu / spam: số lần đăng nhập và số request API tối đa mỗi phút mỗi IP
LOGIN_LIMIT_PER_MIN=10
API_LIMIT_PER_MIN=240

# Bật khi chạy sau proxy (Railway, Render, Nginx) để giới hạn theo đúng IP người chơi
TRUST_PROXY=false

# Để trống nếu trang game và API cùng một địa chỉ (bình thường). Chỉ điền khi host client ở nơi khác, vd https://game.example.com
CORS_ORIGIN=
