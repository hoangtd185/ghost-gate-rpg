# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is gitignored)

# Required. Your IP: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.10/32"

# Optional
# region              = "ap-southeast-1"
# instance_type       = "t3.micro"
# data_volume_gb      = 10
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# github_repository   = "hoangtd185/ghost-gate-rpg"

# Set to false if this AWS account already has the GitHub Actions OIDC provider
# create_github_oidc_provider = false

# Set this to serve HTTPS. Point the domain's A record at the public_ip output, then deploy.
# domain = "game.example.com"
